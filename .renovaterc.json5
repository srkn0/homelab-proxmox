{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  labels: ["dependencies"],
  // single-maintainer homelab: keep the noise down
  schedule: ["before 6am on monday"],
  prHourlyLimit: 2,
  // match the repo's conventional commit style
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  // rev tags in .pre-commit-config.yaml
  "pre-commit": {
    enabled: true,
  },
  packageRules: [
    {
      // The kubespray-sample-merge workflow pushes a commit onto the bump PR.
      // Never rebase so Renovate does not force-push over that commit.
      matchDepNames: ["quay.io/kubespray/kubespray"],
      rebaseWhen: "never",
    },
  ],
  // KUBESPRAY_VERSION in the Taskfile points at the quay.io/kubespray/kubespray
  // image tag; Renovate cannot infer that, so match it explicitly.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^Taskfile\\.ya?ml$/"],
      matchStrings: ["KUBESPRAY_VERSION:\\s*(?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
      depNameTemplate: "quay.io/kubespray/kubespray",
    },
  ],
}
